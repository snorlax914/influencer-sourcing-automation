# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 커밋되지 않습니다)
#
# IG_SESSIONID 얻는 법:
#   크롬 F12 > Application > Cookies > https://www.instagram.com > sessionid 값 복사
# 비워두면 크롬에 저장된 인스타그램 쿠키를 자동으로 읽어옵니다.
IG_SESSIONID=

# LLM 판정(judge.py)에 필요합니다. console.anthropic.com에서 발급받으세요.
# 비워두면 크롤링은 되지만 판정 단계에서 막힙니다.
ANTHROPIC_API_KEY=

# 아래는 대시보드에서 해당 모델을 고를 때만 필요합니다.
OPENAI_API_KEY=
GEMINI_API_KEY=
# 로컬(Ollama)은 키가 필요 없습니다. `ollama serve` 만 떠 있으면 됩니다.
